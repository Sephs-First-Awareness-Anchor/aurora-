{
  "areas": [
    {
      "id": "phone_python",
      "name": "Phone Python bridge (Chaquopy)",
      "prefix": "flutter_app/android/app/src/main/python/"
    },
    {
      "id": "phone_native",
      "name": "Phone native layer (Kotlin)",
      "prefix": "flutter_app/android/"
    },
    {
      "id": "phone_ui",
      "name": "Phone app (Flutter, Dart)",
      "prefix": "flutter_app/"
    },
    {
      "id": "acm",
      "name": "ACM kernel (Rust)",
      "prefix": "aurora-acm/"
    },
    {
      "id": "android_src",
      "name": "Android and other native sources",
      "prefix": "src/"
    },
    {
      "id": "scripts",
      "name": "Maintenance, audit and run scripts",
      "prefix": "scripts/"
    },
    {
      "id": "tests",
      "name": "Test suite",
      "prefix": "tests/"
    },
    {
      "id": "deploy",
      "name": "Deployment",
      "prefix": "deploy/"
    },
    {
      "id": "workflows",
      "name": "CI workflows",
      "prefix": ".github/"
    }
  ],
  "axis_literal_min_distinct": 4,
  "boundaries": [
    {
      "module": "aurora_internal.aurora_leverage_scalar",
      "public": [
        "BandPosition",
        "PhaseNudge",
        "band_position",
        "LeverageBiasEngine"
      ],
      "rule": "Leverage scalar privacy boundary: only band_position and PhaseNudge deltas cross out"
    }
  ],
  "bus_receivers": [
    "systems",
    "_systems"
  ],
  "chaquopy_python_roots": [
    "flutter_app/android/app/src/main/python"
  ],
  "composite_min_binding": 3,
  "constraint_axes": [
    {
      "adjective": "Existential",
      "istate": "IS/ISNT",
      "name": "Existence",
      "name_tokens": [
        "existence",
        "existential"
      ],
      "poles": [
        "Admissible",
        "Inadmissible"
      ],
      "symbol": "X"
    },
    {
      "adjective": "Temporal",
      "istate": "CAN/CANT",
      "name": "Temporal",
      "name_tokens": [
        "temporal"
      ],
      "poles": [
        "Propagating",
        "Stalled"
      ],
      "symbol": "T"
    },
    {
      "adjective": "Energetic",
      "istate": "DO/DONT",
      "name": "Energy",
      "name_tokens": [
        "energy",
        "energetic"
      ],
      "poles": [
        "Sufficient",
        "Insufficient"
      ],
      "symbol": "N"
    },
    {
      "adjective": "Boundary",
      "istate": "SAW/SAUNT",
      "name": "Boundary",
      "name_tokens": [
        "boundary"
      ],
      "poles": [
        "Contained",
        "Dissolved"
      ],
      "symbol": "B"
    },
    {
      "adjective": "Agentive",
      "istate": "DID/DIDNT",
      "name": "Agency",
      "name_tokens": [
        "agency",
        "agentive"
      ],
      "poles": [
        "Corrective",
        "Drifting"
      ],
      "symbol": "A"
    }
  ],
  "domain_fallback": {
    "android_native": "phone",
    "tooling": "desktop"
  },
  "domains": [
    {
      "id": "phone",
      "name": "Phone app (Flutter, Kotlin, Chaquopy Python)",
      "prefixes": [
        "flutter_app/"
      ]
    },
    {
      "id": "acm",
      "name": "ACM kernel (Rust)",
