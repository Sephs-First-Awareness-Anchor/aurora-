        "scripts/",
        "tests/",
        "deploy/",
        ".github/",
        "tools/"
      ]
    },
    {
      "id": "desktop",
      "name": "Desktop runtime (Python)",
      "prefixes": [
        "aurora_internal/",
        "aurora_manifold_directory/"
      ],
      "root_python": true
    }
  ],
